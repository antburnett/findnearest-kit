{
  "name": "findnearest-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared FindNearest UI components for Svelte 5 apps (geocoder search first).",
  "scripts": {
    "dev": "vite dev --port 7013 --strictPort",
    "package": "svelte-kit sync && svelte-package && publint",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "bun test tests"
  },
  "files": [
    "dist"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "svelte": "^5.20.0"
  },
  "devDependencies": {
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/bun": "^1.4.2",
    "publint": "^0.3.24",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9",
    "vite": "^8.3.1"
  }
}
